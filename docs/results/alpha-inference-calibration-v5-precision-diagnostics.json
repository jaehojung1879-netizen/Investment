  "precisionRule": {
    "atProbability": 0.95,
    "chosenReplicates": 8000,
    "confidenceLevel": 0.95,
    "exactClopperPearsonMinimumR": 7501,
    "exactRule": "k = round(0.95 R) successes; half-width of the exact two-sided 95% interval",
    "normalApproximationFormula": "z * sqrt(p (1 - p) / R) <= targetHalfWidth",
    "normalApproximationMinimumR": 7299,
    "normalApproximationRealMinimum": 7298.7717593188,
    "note": "7,500 satisfies the normal approximation but misses the exact half-width by 1.3e-7 (exact minimum 7,501), so the rounded budget is 8,000. The choice follows from the rule and was not made by asking what would classify any cell.",
    "roundingUnit": 500,
    "statement": "The 95% Monte Carlo half-width of a probability estimate at p = 0.95 must be at most 0.5 percentage points, by BOTH the normal approximation and the exact two-sided Clopper-Pearson interval; the budget is the smallest multiple of 500 satisfying both.",
    "targetHalfWidth": 0.005,
    "zValue": 1.9599639845
  },
  "purpose": "Derive the v5 replicate count from a general Monte Carlo precision rule and disclose the exact operating characteristic of the frozen v4 decision rule at generic true-probability values. Computed before the v5 protocol was frozen. Uses no simulation, no registered-cell coverage and no market or Alpha data; the grid is generic and was not tuned to any v4 cell.",
