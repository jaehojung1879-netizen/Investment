  "semanticContract": {
    "amountUnits": "Full KRW as stated by the filer (decimals recorded for original-XBRL records); no scaling.",
    "basisCfsVsOfs": {
      "jsonEndpointRecords": "Consolidated (CFS) is requested first and Separate (OFS) only if CFS served nothing; the answering basis is recorded per record in fsDiv (CFS 8,479; OFS 347).",
      "note": "Downstream feature code does not condition on basis. A company reporting only OFS is compared on that basis, recorded but not adjusted.",
      "originalXbrlRecords": "Per account: an unqualified fact first, otherwise Consolidated over Separate; the winning basis is recorded per account in canonicalization.accounts[*].statementBasis (CFS 1,883; OFS 154 account readings). Different accounts of one filing may resolve under different bases."
    },
    "contract": "KR_ACCOUNTING_SEMANTIC_CONTRACT_V1",
    "duplicatesAndMultipleReceipts": {
      "candidateRows": "Inside the first statement that has candidates for an account, candidates that disagree on amounts make the account AMBIGUOUS and it is omitted; a component row (account_detail other than '-') is never a total.",
      "multipleReceipts": "0 records carry more than one receipt number. Several would take the earliest as availableFrom, and visible_filings would refuse a record whose receipt dates differ.",
      "recordIds": "Unique in the snapshot (9,351 ids, 9,351 records). historical_store.write_shard keeps the first write of an id.",
      "sourceCollision": "If an id existed in both kr-canonical-v2 and kr-xbrl-original the merger raises CANDIDATE_SOURCE_COLLISION rather than choose."
    },
    "families": {
      "assets": {
        "account": "자산총계",
        "ifrsElement": "Assets",
        "meaning": "Total assets at the period end, level, KRW.",
        "statement": "BS"
      },
      "liabilities": {
        "account": "부채총계",
        "ifrsElement": "Liabilities",
        "meaning": "Total liabilities at the period end, level, KRW.",
        "statement": "BS"
      },
      "net_income": {
        "account": "당기순이익",
        "ifrsElement": "ProfitLoss",
        "meaning": "Profit or loss for the period including non-controlling interests, cumulative year-to-date; never ProfitLossAttributableToOwnersOfParent.",
        "statement": "IS or CIS (CF label fallback only via exact label)"
      },
      "operating_cash_flow": {
        "account": "영업활동현금흐름",
        "ifrsElement": "CashFlowsFromUsedInOperatingActivities",
        "meaning": "Net cash flows from operating activities, cumulative year-to-date; never the 'cash generated from operations' subtotal.",
        "statement": "CF"
      }
    },
    "filingAndAmendmentTreatment": {
      "identity": "One record per ticker x fiscalYear x reportCode (id ticker:fiscalYear:reportCode). The snapshot holds exactly one value per filing.",
      "jsonEndpointRecords": "fnlttSinglAcntAll serves the LATEST amendment's receipt for a filing, so its availableFrom is that later date. 2,639 records are dated after their statutory deadline. This is point-in-time honest (the later date) but the earlier original values are not recoverable from this snapshot.",
      "originalXbrlRecords": "The 525 fiscal-2015 Q1/H1/Q3 records come from the ORIGINAL filing selected from DART list.json by its own report label with the amendment marker excluded; an amendment is never substituted.",
      "restatements": "Not modelled. A later restatement is not a new record in this snapshot; where the endpoint served an amendment it replaced the original in place at collection time."
    },
    "missingValues": {
      "measured": "400 of 9,351 records lack at least one of the four families.",
      "rule": "An account absent from a filing is absent from record.accounts and reads as None. Never 0.0, never imputed. Absence lowers coverage; it is not a value."
    },
    "noFutureFillNoLookAhead": {
      "rules": [
        "only filings with availableFrom < as-of date are visible",
        "the current filing is the latest visible by (fiscalYear, stage order Q1<H1<Q3<annual), and priors come only from the same visible set",
        "share counts may be carried forward from an earlier visible filing, never from a later one",
        "no forward fill of a missing account from any other period",
        "whole-history derivation followed by filtering is forbidden"
      ]
    },
    "periodSemantics": {
      "flows": "Flow accounts are cumulative from fiscal-year start to the period end. Annual: thstrm_amount. Quarterly IS/CIS: thstrm_add_amount (year-to-date; thstrm_amount is the quarter alone). Cash flow: the single reported column is already year-to-date.",
      "levels": "Balance-sheet accounts are levels at the period end (thstrm_amount); never rolled forward or averaged.",
      "reportCodes": {
        "11011": "annual, 12 months to 12-31",
        "11012": "half-year, 6 months to 06-30",
        "11013": "Q1, 3 months to 03-31",
        "11014": "Q3, 9 months to 09-30"
      },
      "trailingTwelveMonths": "Annual figure as filed; otherwise TTM = FY(Y-1) - cumulative(Y-1, same stage) + cumulative(Y, stage), requiring both prior filings to be visible; anything missing gives None. Never annualised."
    },
    "pointInTimeAvailability": {
      "availableFrom": "The date in the head of the DART receipt number (dart_fundamentals.receipt_date); the minimum over a filing's receipts. A filing with no receipt date is refused at collection.",
      "measured": "2 of 9,351 records fail the receipt-equals-availableFrom test (005300.KS:2015:11013, 019170.KS:2015:11012) and are never visible.",
      "visibleTo": "A filing is usable for an as-of date D only if availableFrom < D (strictly earlier; intraday release time is unknown) AND every receipt number's date prefix equals availableFrom (alpha_opportunity_features.visible_filings). Nothing derived from a filing that is not yet visible may be used, including as a prior in a rollforward."
    },
    "sourcePrecedence": {
      "rule": "The two sources are disjoint by construction, so no precedence is needed and none is applied: kr-xbrl-original covers only fiscal-2015 Q1/H1/Q3 (525 records); kr-canonical-v2 covers every other filing including the FY2015 annual (175). A collision is an error.",
      "validation": "kr-original-xbrl-value-validation-v3 confirmed 60 of 60 fixed-sample original-XBRL records against source; canonical-v2 records were not validated against original packages by that audit."
    }
